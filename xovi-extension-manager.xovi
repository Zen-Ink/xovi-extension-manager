version 0.3.0

condition getScannedExtensionCount

global-meta
    id = "xovi-extension-manager"
    name = "XOVI Extension Manager"
    author = "lurenmax"
    description = "Manifest-based package inventory, install, and enable/disable control for XOVI and QMD packages"
    license = "MIT"
    requiresXovi = ">=0.3.0"
    requiresExtensions = "xovi-message-broker:>=0.2.0"
    architectures = "aarch64,arm"
    xochitlVersions = "3.27.x.x,3.28.x.x"
    entry = "xovi-extension-manager.so"
end

export xovi_extension_manager_list
with
    xovi-message-broker$version = 1
    xovi-message-broker$simpleSignal = "xovi-extension-manager$list"
end

export xovi_extension_manager_get
with
    xovi-message-broker$version = 1
    xovi-message-broker$simpleSignal = "xovi-extension-manager$get"
end

